function adminStart_(p){const email=String(p.email||'').trim().toLowerCase();if(email!==CFG.ADMIN_EMAIL.toLowerCase())throw new Error('Этот адрес не имеет доступа к редакторской панели.');const cache=CacheService.getScriptCache();if(cache.get('OTP_WAIT_'+email))throw new Error('Подождите минуту перед повторным запросом кода.');cache.put('OTP_WAIT_'+email,'1',60);const otp=String(Math.floor(100000+Math.random()*900000));cache.put('OTP_'+email,otp,600);cache.put('OTP_FAIL_'+email,'0',600);MailApp.sendEmail(email,'Код входа — Купи-Продай Казахстан','Ваш одноразовый код: '+otp+'\nДействует 10 минут. Если вы не запрашивали вход, проигнорируйте письмо.');return {message:'Код отправлен на разрешённый адрес редакции.'};}
function adminVerify_(p){const email=String(p.email||'').trim().toLowerCase();const cache=CacheService.getScriptCache();const otp=cache.get('OTP_'+email);if(email!==CFG.ADMIN_EMAIL.toLowerCase()||!otp)throw new Error('Неверный или просроченный код.');if(otp!==String(p.code||'')){const fails=Number(cache.get('OTP_FAIL_'+email)||0)+1;cache.put('OTP_FAIL_'+email,String(fails),600);if(fails>=5){cache.remove('OTP_'+email);cache.remove('OTP_FAIL_'+email);}throw new Error(fails>=5?'Слишком много попыток. Запросите новый код позже.':'Неверный код. Осталось попыток: '+(5-fails));}cache.remove('OTP_'+email);cache.remove('OTP_FAIL_'+email);const token=Utilities.getUuid()+Utilities.getUuid();cache.put('ADM_'+token,email,21600);return {session:token,email:email,expires_in:21600};}
function requireAdmin_(token){const email=CacheService.getScriptCache().get('ADM_'+String(token||''));if(!email||email.toLowerCase()!==CFG.ADMIN_EMAIL.toLowerCase())throw new Error('Сеанс редактора истёк. Войдите снова.');return email;}
function adminDashboard_(){return {ads:rows_(CFG.SHEETS.ads).filter(a=>['pending','review'].includes(a.status)).map(a=>({id:a.ad_id,title:a.title,description:a.description,kind:a.kind,category:a.category,region:a.region,city:a.city,contact_name:a.contact_name,phone:a.phone,language:a.language_submitted,status:a.status,photo_urls:parseJson_(a.photo_urls,[])})),purchases:rows_('Платежи').filter(p=>p.status==='pending').map(p=>({id:p.request_id,request_id:p.request_id,name:p.buyer_name,phone:p.buyer_phone,issue_id:p.issue_id,issue_label:p.issue_number,status:p.status,amount:p.amount})),feedback:rows_('Отзывы').filter(f=>f.status==='new'),issues:rows_('Выпуски').slice(-10).reverse()};}
function adminDecision_(p){const allowed=['approve','reject','review'];if(allowed.indexOf(p.decision)<0)throw new Error('Недопустимое решение.');const sh=sheet_(CFG.SHEETS.ads);const data=sh.getDataRange().getValues(),h=data[0],idc=h.indexOf('ad_id'),sc=h.indexOf('status'),uc=h.indexOf('updated_at'),mc=h.indexOf('moderated_by'),mt=h.indexOf('moderated_at'),rc=h.indexOf('rejection_reason'),nc=h.indexOf('moderator_note'),pc=h.indexOf('published_at');let row=-1;for(let i=1;i<data.length;i++)if(String(data[i][idc])===String(p.ad_id)){row=i+1;break;}if(row<0)throw new Error('Объявление не найдено.');const status=p.decision==='approve'?'approved':p.decision==='reject'?'rejected':'review';sh.getRange(row,sc+1).setValue(status);sh.getRange(row,uc+1).setValue(new Date());sh.getRange(row,mc+1).setValue(CFG.ADMIN_EMAIL);sh.getRange(row,mt+1).setValue(new Date());sh.getRange(row,rc+1).setValue(p.decision==='reject'?(p.reason||'Отклонено редакцией'):'');sh.getRange(row,nc+1).setValue(p.note||'');if(status==='approved')sh.getRange(row,pc+1).setValue(new Date());return {ad_id:p.ad_id,status:status};}
function adminGrant_(p){const sh=sheet_('Платежи'),data=sh.getDataRange().getValues(),h=data[0];let row=-1;for(let i=1;i<data.length;i++)if(String(data[i][h.indexOf('request_id')])===String(p.request_id)){row=i+1;break;}if(row<0)throw new Error('Запрос оплаты не найден.');const issueId=sh.getRange(row,h.indexOf('issue_id')+1).getValue();const token=Utilities.getUuid()+Utilities.getUuid();const exp=nextIssueBoundary_();[['status','paid'],['admin_note',p.note||'Оплата проверена вручную'],['access_token',token],['access_expires_at',exp],['granted_at',new Date()]].forEach(([k,v])=>sh.getRange(row,h.indexOf(k)+1).setValue(v));const base=PropertiesService.getScriptProperties().getProperty('SITE_BASE_URL')||'';return {access_url:base?base+'/search-issue.html?token='+encodeURIComponent(token)+'&issue_id='+encodeURIComponent(issueId):'search-issue.html?token='+token+'&issue_id='+encodeURIComponent(issueId),expires_at:exp.toISOString(),issue_id:issueId};}
function nextIssueBoundary_(){const now=new Date();const day=Number(Utilities.formatDate(now,CFG.TIMEZONE,'u'));let add=(8-day)%7;if(add===0)add=7;const date=new Date(now.getTime()+add*24*60*60*1000);const y=Number(Utilities.formatDate(date,CFG.TIMEZONE,'yyyy')),m=Number(Utilities.formatDate(date,CFG.TIMEZONE,'MM'))-1,d=Number(Utilities.formatDate(date,CFG.TIMEZONE,'dd'));return new Date(Date.UTC(y,m,d,1,0,0));}
function validAccess_(token,issueId){const now=new Date();return rows_('Платежи').some(p=>String(p.access_token)===String(token)&&String(p.issue_id)===String(issueId)&&p.status==='paid'&&p.access_expires_at&&new Date(p.access_expires_at)>now);}
function parseJson_(v,fallback){try{return JSON.parse(v||'');}catch(e){return fallback;}}
function truth_(v){return v===true||v===1||String(v).toLowerCase()==='true'||String(v)==='1'||String(v).toLowerCase()==='yes';}
function formatDate_(v){return v instanceof Date?Utilities.formatDate(v,CFG.TIMEZONE,'yyyy-MM-dd'):String(v||'').slice(0,10);}
