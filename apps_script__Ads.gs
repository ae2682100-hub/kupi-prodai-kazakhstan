function getFormData_(){
 const map=(name,activeCol,fields)=>rows_(name).filter(r=>truth_(r[activeCol])).map(r=>{const o={};fields.forEach(k=>o[k]=r[k]);return o;});
 return {categories:map(CFG.SHEETS.categories,'active',['category_id','category_ru','category_kk','category_type','parent_category_id','parent_ru','parent_kk','source_form_value']),kinds:map(CFG.SHEETS.kinds,'active',['kind_id','kind_ru','kind_kk','source_form_value']),regions:map(CFG.SHEETS.regions,'active',['region_id','region_ru','region_kk','source_form_value']),cities:map(CFG.SHEETS.cities,'active',['city_id','city_ru','city_kk','source_form_value'])};
}
function submitAd_(p){
  const lock=LockService.getScriptLock();lock.waitLock(20000);
  try{
    if(p.website) throw new Error('Заявка отклонена.');
    ['contact_name','phone','kind','category','title','description','region','city'].forEach(k=>{if(!String(p[k]||'').trim())throw new Error('Заполните обязательное поле: '+k);});
    if(!truth_(p.consent))throw new Error('Необходимо согласие на обработку данных.');
    const photoUrls=Array.isArray(p.photo_urls)?p.photo_urls:[];if(photoUrls.length>CFG.MAX_PHOTOS)throw new Error('Максимум 5 фотографий.');
    const dict=getFormData_();
    const kind=findDict_(dict.kinds,p.kind);const cat=findDict_(dict.categories,p.category);const reg=findDict_(dict.regions,p.region);const city=findDict_(dict.cities,p.city);
    const dupe=duplicateKey_(p);const recent=rows_(CFG.SHEETS.ads).some(a=>String(a.duplicate_key||'')===dupe&&new Date(a.created_at).getTime()>Date.now()-7*24*60*60*1000);if(recent)throw new Error('Похожее объявление с этим телефоном уже отправлялось за последние 7 дней.');const phoneKey=Utilities.base64EncodeWebSafe(String(p.phone).replace(/\D/g,''));const cache=CacheService.getScriptCache();if(cache.get('SUBMIT_'+phoneKey))throw new Error('С этого номера недавно уже отправляли заявку. Попробуйте позже.');cache.put('SUBMIT_'+phoneKey,'1',90);
    const now=new Date(),id=Utilities.getUuid();
    const sh=sheet_(CFG.SHEETS.ads);const obj={ad_id:id,created_at:now,updated_at:now,status:'pending',issue_id:'',contact_name:String(p.contact_name).trim(),phone:String(p.phone).trim(),whatsapp:String(p.whatsapp||'').trim(),kind_id:kind.category_id||kind.kind_id||'',kind:String(p.kind),kind_ru:kind.kind_ru||String(p.kind),kind_kk:kind.kind_kk||'',category_id:cat.category_id||'',category:String(p.category),category_ru:cat.category_ru||String(p.category),category_kk:cat.category_kk||'',category_type:cat.category_type||'',parent_category_id:cat.parent_category_id||'',title:String(p.title).trim(),description:String(p.description).trim(),price:p.price===''||p.price===null? '':Number(p.price),price_condition:String(p.price_condition||'Цена указана'),currency:'KZT',region_id:reg.region_id||'',region:String(p.region),region_ru:reg.region_ru||String(p.region),region_kk:reg.region_kk||'',city_id:city.city_id||'',city:String(p.city),city_ru:city.city_ru||String(p.city),city_kk:city.city_kk||'',district:String(p.district||''),language_submitted:p.language_submitted||'ru',consent:true,consent_at:now,photo_count:photoUrls.length,photo_urls:JSON.stringify(photoUrls),moderator_note:'',moderated_by:'',moderated_at:'',published_at:'',rejection_reason:'',source:'website',duplicate_key:dupe,contract_version:'2.0'};
    const headers=CFG.AD_HEADERS;sh.appendRow(headers.map(h=>obj[h]===undefined?'':obj[h]));sheet_('Разрешения').appendRow([id,truth_(p.publish_contacts),now]);return {ad_id:id,status:'pending',message:'Заявка принята и отправлена на проверку редакции.'};
  }finally{lock.releaseLock();}
}
function uploadPhoto_(f){if(!f||!f.data||!f.mime)throw new Error('Повреждён файл фотографии.');if(!/^image\/(jpeg|png|webp)$/.test(f.mime))throw new Error('Разрешены JPG, PNG и WebP.');const bytes=Utilities.base64Decode(String(f.data).replace(/^data:[^,]+,/,''));if(bytes.length>CFG.MAX_PHOTO_BYTES)throw new Error('Каждая фотография не должна превышать 5 МБ.');const folder=DriveApp.getFolderById(PropertiesService.getScriptProperties().getProperty('KUPI_DRIVE_FOLDER_ID'));const blob=Utilities.newBlob(bytes,f.mime,String(f.name||'photo').replace(/[^\w.\-]/g,'_'));const file=folder.createFile(blob);file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);return 'https://drive.google.com/uc?export=view&id='+file.getId();}
function findDict_(arr,val){const s=String(val||'').trim().toLowerCase();return arr.find(o=>Object.keys(o).some(k=>String(o[k]||'').trim().toLowerCase()===s))||{};}
function duplicateKey_(p){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,[p.phone,p.title,p.city].join('|').toLowerCase()).map(b=>(b+256).toString(16).slice(-2)).join('');}
function searchAds_(p){const issue=currentIssueRow_();if(!issue)return {ads:[],issue:null};return issueAds_({issue_id:issue.issue_id,filters:p.filters||{},token:p.token||''});}
