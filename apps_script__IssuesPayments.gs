function currentIssueRow_(){const all=rows_('Выпуски').filter(x=>x.status==='published');all.sort((a,b)=>new Date(b.issue_date)-new Date(a.issue_date));return all[0]||null;}
function currentIssue_(){const x=currentIssueRow_();return {issue:x?publicIssue_(x):null};}
function publicIssue_(x){return {issue_id:x.issue_id,issue_number:x.issue_number,issue_date:formatDate_(x.issue_date),published_at:x.published_at,promo_count:x.promo_count,promo_visible:truth_(x.promo_visible),ad_count:Number(x.ad_count)||0};}
function contactAllowed_(adId){return rows_('Разрешения').some(x=>String(x.ad_id)===String(adId)&&truth_(x.contact_publication_consent));}
function issueAds_(p){const issue=p.issue_id?rows_('Выпуски').find(x=>x.issue_id===p.issue_id):currentIssueRow_();if(!issue)return {ads:[],issue:null};const full=!!(p.token&&validAccess_(p.token,issue.issue_id));const current=currentIssueRow_();if(!full&&(!current||String(issue.issue_id)!==String(current.issue_id)))throw new Error('Публичный архив выпусков закрыт.');const all=rows_(CFG.SHEETS.ads).filter(a=>String(a.issue_id)===String(issue.issue_id)&&a.status==='approved');const filters=p.filters||{};const selected=all.filter(a=>matches_(a,filters));const ads=selected.map(a=>({ad_id:a.ad_id,title:a.title,description:a.description,price:a.price,price_condition:a.price_condition,kind:a.kind,category:a.category,region:a.region,city:a.city,district:a.district,photo_urls:parseJson_(a.photo_urls,[]),contact_name:full&&truth_(a.consent)&&contactAllowed_(a.ad_id)?a.contact_name:'',phone:full&&truth_(a.consent)&&contactAllowed_(a.ad_id)?a.phone:'',whatsapp:full&&truth_(a.consent)&&contactAllowed_(a.ad_id)?a.whatsapp:'',contacts_visible:full&&truth_(a.consent)&&contactAllowed_(a.ad_id)}));const meta=publicIssue_(issue);meta.access_type=full?'full':'free';return {ads,issue:meta,access_type:full?'full':'free'};}
function matches_(a,f){const norm=x=>String(x||'').toLowerCase();return (!f.category||norm(a.category).includes(norm(f.category)))&&(!f.kind||norm(a.kind)===norm(f.kind))&&(!f.region||norm(a.region)===norm(f.region))&&(!f.city||norm(a.city).includes(norm(f.city)))&&(!f.district||norm(a.district).includes(norm(f.district)))&&(!f.keyword||norm([a.title,a.description,a.category,a.region,a.city].join(' ')).includes(norm(f.keyword)))&&(f.minPrice==null||f.minPrice===''||Number(a.price)>=Number(f.minPrice))&&(f.maxPrice==null||f.maxPrice===''||Number(a.price)<=Number(f.maxPrice));}
function createIssue_(manual){const lock=LockService.getScriptLock();lock.waitLock(20000);try{const current=currentIssueRow_();const today=new Date();if(!manual&&current&&formatDate_(current.issue_date)===Utilities.formatDate(today,CFG.TIMEZONE,'yyyy-MM-dd'))return {message:'Выпуск на эту дату уже создан.',issue:publicIssue_(current)};const ads=rows_(CFG.SHEETS.ads).filter(a=>a.status==='approved'&&!a.issue_id);const all=rows_('Выпуски');const serial=String(all.length+1).padStart(7,'0');const dateStr=Utilities.formatDate(today,CFG.TIMEZONE,'yyyy-MM-dd');const promo=String(Math.floor(Math.random()*3)+1)+Utilities.formatDate(today,CFG.TIMEZONE,'yyMMdd');const id=Utilities.getUuid();const sh=sheet_('Выпуски');sh.appendRow([id,serial,dateStr,new Date(),'published',ads.length,promo,ads.length>0&&(Math.random()<0.65),new Date()]);if(ads.length){const adSh=sheet_(CFG.SHEETS.ads);const data=adSh.getDataRange().getValues();const headers=data[0];const idCol=headers.indexOf('ad_id')+1,issueCol=headers.indexOf('issue_id')+1,pubCol=headers.indexOf('published_at')+1;const set= new Set(ads.map(a=>String(a.ad_id)));for(let r=2;r<=data.length;r++){if(set.has(String(data[r-1][idCol-1]))){adSh.getRange(r,issueCol).setValue(id);adSh.getRange(r,pubCol).setValue(new Date());}}}return {message:'Выпуск создан.',issue:{issue_id:id,issue_number:serial,issue_date:dateStr,ad_count:ads.length,promo_count:promo}};}finally{lock.releaseLock();}}
function purchaseRequest_(p){if(!p.buyer_name||!p.buyer_phone||!p.issue_id)throw new Error('Укажите имя, телефон и выпуск.');const issue=rows_('Выпуски').find(x=>x.issue_id===p.issue_id);if(!issue)throw new Error('Выбранный выпуск не найден.');const id=Utilities.getUuid();sheet_('Платежи').appendRow([id,new Date(),issue.issue_id,issue.issue_number,String(p.buyer_name),String(p.buyer_email||''),String(p.buyer_phone),CFG.PRICE_KZT,'pending',String(p.payment_reference||''),'','','','']);return {request_id:id,amount:CFG.PRICE_KZT,status:'pending',message:'Запрос сохранён. После оплаты 500 ₸ редакция проверит поступление и выдаст доступ.'};}
function saveFeedback_(p){if(!String(p.message||'').trim())throw new Error('Введите текст обращения.');const id=Utilities.getUuid();sheet_('Отзывы').appendRow([id,new Date(),p.name||'',p.contact||'',p.kind||'review',String(p.message).slice(0,5000),'new']);return {feedback_id:id,message:'Обращение отправлено редакции.'};}
